* text=auto eol=lf
*.png binary
*.bin binary
*.pbm binary
# Golden images are reviewed visually, never line-diffed.
test/golden/**/*.png binary -diff
components/**/golden/**/*.png binary -diff
# Vendored third-party code must stay byte-identical to upstream (provenance hashes).
components/*/third_party/** -text
components/qz_gfx/fonts/** -text
